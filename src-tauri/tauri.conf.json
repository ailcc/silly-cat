{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SillyCat",
  "version": "0.0.7",
  "identifier": "com.drew.sillycat",
  "build": {
    "frontendDist": "../prototype"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "捣蛋奶牛猫",
        "width": 420,
        "height": 345,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "customLanguageFiles": {
          "SimpChinese": "installer/SimpChinese.nsh",
          "English": "installer/English.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEODk0RjVGOUE1NTk2MUEKUldRYWxsV2FYMCtKcmRtbFFoSzRHUUhHaEtwN3U5M0xOUVpzdUpldVJyMERiTEFmU1MxaSsyekMK",
      "endpoints": [
        "https://github.com/ailcc/silly-cat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
