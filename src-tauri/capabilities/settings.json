{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "设置窗口：读取 / 保存时间参数、输入监控授权处理（自定义 command），关闭自己；显示授权提示时调整自己的高度",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "dialog:default"
  ]
}
